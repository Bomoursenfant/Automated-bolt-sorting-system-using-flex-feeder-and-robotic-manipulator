
'''//////////////////////////AUTOMATION PROGRAM FINAL////////////////////////////////////
'
'''********************************************************************
'''//LIST INPUT RECEIVE FROM PLC
'''INPUT TO ROBOT WHEN PLC STOP CONVEYOR(I6)
'''WAIT INPUT FROM PLC WHEN FEEDER GO TO HOME(I1)
'''WAIT INPUT FROM PLC WHEN UP FEEDER COMPLETED(I8)
'''WAIT PLC ALLOW RUN PROGRAM(I11)
'''WAIT INPUT SIGNAL PICK UP OBJECT SUCCESSFUL(I22, I24)
'
'''//LIST OUTPUT SEND TO PLC
'''OUTPUT WHEN START PROGRAM(O1)
'''OUTPUT WHEN ROBOT IN HOME POSITION(O3)
'''OUTPUT WHEN ROBOT PICK UP COMPLETE 12 OBJECT(O2)  
'''CALL FEEDER RUN MODE 1(O4)
'''CALL FEEDER RUN MODE 2(O5)
'''CALL FEEDER UP RUN(O6)
'''OUTPUT FOR LAMP(O9)
'''OUTPUT FOR GRIP(O10,011)
'''OUTPUT COUNT NUMBER GRIP(O12)
'''OUTPUT WARNING PICK UP OBJECT NOT SUCCESSFUL(O13)
'''********************************************************************
''

'//////////////////////////START//////////////////////////////
'WAIT FOR PLC CALL

'SEND START PROGRAM OUTPUT NO.1 FOR PLC 
SETM O1,1
DELAY 5


'/////////DEFINE AND SETTING VARIABLE
'DEFINE VARIABLE DEFINITION FILE
INCLUDE "SAMPLE"

'DEFINE POSITION AND ARRAY FOR MOVE PALLET COMMAND
DIM POSCURRENT AS POSITION 

'DEFINE PALLET POSITION ARRAY
DIM POSPALLET[7] AS SINGLE

'DEFINE NUMBER OBJECT DETECTED VARIABLE
DIM OBJ_DETECTED AS INTEGER

'DEFINE OBJECT IN PALLET INDEX
DIM NUMB_OBJ_PALLET AS INTEGER

'DEFINE TOTAL_OBJECT_NEXT VARIABLE 
DIM TOTAL_OBJECT_NEXT AS INTEGER

'DEFINE INDEX POSITION VARIABLE 
DIM INDEX_POSITION AS INTEGER

'DEFINE STATE PALLET 
DIM STATE AS INTEGER

'VARIABLE OF ROBOT SPEED
SPEED_ROBOT=15

'SET UP/DOWN RB
Z_UP_RB = 300.0
Z_DOWN_FEEDER = 187.7
Z_DOWN_PALLET = 46.55

'SET NUMBER OBJECT IN PALLET
NUMB_OBJ_PALLET=1

'SET NUMBER OBJECT DETECTED
OBJ_DETECTED=0

STATE=0
TOTAL_OBJECT_NEXT=0
SETM O9,1
'USE POSE FILE NO.4 FOR MOVE TO HOME AND ANOTHER POSITION
USE 4
'#HOME POSITION
GOSUB *MOVE_HOME

'WAIT INPUT FROM PLC WHEN FEEDER GO TO HOME
WAITI I1

'WAIT PLC SEND RUN PROGRAM INPUT
WAITI I11
DELAY 0.5

*START
'WAIT INPUT FROM PLC WHEN FEEDER GO TO HOME
DELAY 0.5
WAITI I1
WAITI I8
INDEX_POSITION=310

V6%=1
CALLMCR 2, 10000

IF V301% = 0
IF V302% >= 10
CallProc RunDownFeeder1()
STATE=1
GOTO *START
ELSEIF V302% < 10
*CONTINUE_RUN_UP
'SUPPLY OBJECT FOR UP FEEDER
CallProc RunUpFeeder()
WAITI I8
WAITI I1

'DELAY 1
DELAY 0.5
V6%=2
CALLMCR 2, 10000

DELAY 0.5
IF V302% = 0 OR V302% < 10
GOTO *CONTINUE_RUN_UP
ENDIF
CallProc RunDownFeeder1()
STATE=1
GOTO *START
ENDIF
ELSEIF V301% > 0 AND V301% < 12
OBJ_DETECTED = V301% 
ELSEIF V301% >= 12
OBJ_DETECTED = 12
ENDIF
TOTAL_OBJECT_NEXT = V302% - V301%
*NEXT_LOOP
WHILE OBJ_DETECTED > 0
'MOVE ROBOT TO FEEDER
GOSUB *MOVE_ROBOT
'MOVE ROBOT TO PALLET
GOSUB *MOVE_PALLET
'MOVE TO HOME
GOSUB *MOVE_HOME
INDEX_POSITION=INDEX_POSITION+3
NUMB_OBJ_PALLET=NUMB_OBJ_PALLET+1
OBJ_DETECTED=OBJ_DETECTED-1
IF NUMB_OBJ_PALLET > 1
SETM O2,1
DELAY 0.5
SETM O2,0
NUMB_OBJ_PALLET=1
GOSUB *MOVE_HOME
'IF OBJ_DETECTED > 0
'GOTO *NEXT_LOOP
'ENDIF
GOTO *START
ENDIF
ENDW

IF TOTAL_OBJECT_NEXT < 10
GOTO *CONTINUE_RUN_UP
ELSEIF TOTAL_OBJECT_NEXT >= 10
IF STATE=1
CallProc RunDownFeeder2()
STATE=0
ELSEIF STATE=0
CallProc RunDownFeeder1()
STATE=1
ENDIF
GOTO *START
ENDIF


GOSUB *MOVE_HOME
DELAY 1
GOTO *START

*END_START
SETM O1,0
END

'////////////////////////MOVE FUNCTION//////////////////////////////

*MOVE_HOME
USE 4
'#GO TO HOME POSITION
MOVEX A=8, M1X, P, P1, R=SPEED_ROBOT, H=31, MS, CONF=0000
CallProc CloseGrip()
DELAY 1
SETM O3,1
RETURN 
END

*MOVE_ROBOT
USE 4
SETM O3,0
'#GO TO FEEDER
MOVEX A=8, M1X, P, P2, R=SPEED_ROBOT, H=31, MS, CONF=0000
'MOVE TO POINT THEN PICK UP ITEM
P50 = (V![INDEX_POSITION], V![INDEX_POSITION+1], Z_UP_RB, V![INDEX_POSITION+2], 0, 0)
P51 = (V![INDEX_POSITION], V![INDEX_POSITION+1], Z_DOWN_FEEDER, V![INDEX_POSITION+2], 0, 0)
MOVEX A=8, M1X, P, P50, R=SPEED_ROBOT, H=31, MS, CONF=0000
'MOVE Z ONLY DOWN
MOVEX A=8, M1X, L, P51, R=SPEED_ROBOT, H=31, MS, CONF=0000
'DELAY 1
CallProc OpenGrip()
'MOVE Z ONLY UP
MOVEX A=8, M1X, L, P50, R=SPEED_ROBOT, H=31, MS, CONF=0000
'#GO TO PALLET
MOVEX A=8, M1X, P, P5, R=SPEED_ROBOT, H=31, MS, CONF=0000
RETURN 
END

*MOVE_PALLET
SETM O3,0
'MOVEX A=1, M1X, P, (-30.40, 358.90, 360.11, -1.37, 0.0, 0.0), R=SPEED_ROBOT, H=31, MS, CONF=0000
'WAIT CONVEYOR STOP
WAITI I6
'USE POSE FILE NO.5 FOR MOVE TO PALLET POSITIONS 
USE 3
POSE2POS 0, P[NUMB_OBJ_PALLET], POSCURRENT, 0, 1
OPEPOS 0, POSCURRENT, POSPALLET[1], 0, 0
P60 = (POSPALLET[1], POSPALLET[2], Z_UP_RB, POSPALLET[4], 0, 0)
P61 = (POSPALLET[1], POSPALLET[2], Z_DOWN_PALLET, POSPALLET[4], 0, 0)
MOVEX A=1, M1X, P, P60, R=SPEED_ROBOT, H=31, MS, CONF=0000
MOVEX A=1, M1X, L, P61, R=SPEED_ROBOT, H=31, MS, CONF=0000
CallProc CloseGrip()
DELAY 0.5
MOVEX A=1, M1X, L, P60, R=SPEED_ROBOT, H=31, MS, CONF=0000
DELAY 0.5
MOVEX A=1, M1X, P, (-30.40, 358.90, 360.11, -1.37, 0.0, 0.0), R=SPEED_ROBOT, H=31, MS, CONF=0000
RETURN
END


'#DEFINE USER PROCEDURE
'DEFINE USER PROCEDURE OPEN GRIP
UsrProc RunUpFeeder()

'CAPTURE AND GET NUMBER OF OBJECT
WAITI I1
SETM O6,1
DELAY 0.5
SETM O6,0
WAITI I8
EndProc

UsrProc RunDownFeeder1()
WAITI I8
SETM O4,1
DELAY 0.6
SETM O4,0
WAITI I1
EndProc

UsrProc RunDownFeeder2()
WAITI I8
SETM O5,1
DELAY 0.6
SETM O5,0
WAITI I1
'DELAY 1
EndProc


UsrProc OpenGrip()
SETM O10,1
SETM O11,0
DELAY 0.2
WAITI I24
EndProc

'DEFINE USER PROCEDURE CLOSE GRIP
UsrProc CloseGrip()
SETM O10,0
SETM O11,1
DELAY 0.2
WAITI I22
EndProc







































