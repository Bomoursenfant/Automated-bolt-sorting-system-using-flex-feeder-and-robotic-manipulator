
'////////////////////MANUAL PROGRAM////////////////////////

V350%=3
SETM O13,1
DELAY 2
SETM O13,0
USE 4
*START

IF I13
'HOME POSITION
MOVEX A=8, M1X, P, P1, R=V350%, H=31, MS, CONF=0000
CallProc CloseGrip()

ELSEIF I9
'FEEDER POSITION
MOVEX A=8, M1X, P, P2, R=V350%, H=31, MS, CONF=0000
CallProc OpenGrip()

ELSEIF I20
'PALLET POSITION
MOVEX A=8, M1X, P, P5, R=V350%, H=31, MS, CONF=0000
CallProc CloseGrip()
ENDIF
GOTO *START
END

'#DEFINE USER PROCEDURE
'DEFINE USER PROCEDURE OPEN GRIP
UsrProc OpenGrip()
SETM O10,1
SETM O11,0
EndProc
'DEFINE USER PROCEDURE CLOSE GRIP
UsrProc CloseGrip()
SETM O10,0
SETM O11,1
EndProc